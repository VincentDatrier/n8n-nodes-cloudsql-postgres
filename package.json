{
  "name": "n8n-nodes-cloudsql-postgres",
  "version": "1.2.1",
  "description": "n8n node for Google Cloud's CloudSQL Postgres server, using the Cloud SQL Connector for authentication.",
  "license": "MIT",
  "homepage": "",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Vincent Datrier",
    "email": "github.g4jke@simplelogin.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VincentDatrier/n8n-nodes-cloudsql-postgres.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/CloudSqlPostgres.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CloudSqlPostgres/CloudSqlPostgres.node.js",
      "dist/nodes/CloudSqlPostgres/CloudSqlPostgresTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/lodash": "^4.17.24",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "release-it": "19.2.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.9.2",
    "google-auth-library": "^10.6.2",
    "pg-promise": "^12.6.2"
  }
}
